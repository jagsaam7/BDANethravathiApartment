<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --green-dark: #0f3d2b;
    --green-mid: #1a5c3c;
    --green-accent: #2d8a5e;
    --gold: #c9922a;
    --gold-light: #e8b84b;
    --cream: #faf7f2;
    --text: #1a1a1a;
    --text-muted: #5a5a5a;
    --border: #e0d8cc;
    --white: #ffffff;
  }
  body { font-family: 'Inter', sans-serif; background: var(--cream); color: var(--text); min-height: 100vh; }

  /* HEADER */
  .site-header { background: var(--green-dark); position: sticky; top: 0; z-index: 100; border-bottom: 2px solid var(--gold); }
  .header-inner { max-width: 1100px; margin: 0 auto; padding: 0 20px; display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 12px; }
  .logo-area { display: flex; align-items: center; gap: 12px; text-decoration: none; flex-shrink: 0; }
  .logo-emblem { width: 48px; height: 48px; border-radius: 50%; background: var(--gold); display: flex; align-items: center; justify-content: center; flex-shrink: 0; border: 2px solid rgba(255,255,255,0.25); position: relative; overflow: hidden; }
  .logo-emblem img { width: 100%; height: 100%; object-fit: cover; opacity: 0.85; filter: saturate(0.7) brightness(1.2); }
  .logo-emblem::after { content: 'BDA'; position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%); font-size: 7px; font-weight: 700; color: white; letter-spacing: 1px; background: rgba(0,0,0,0.55); padding: 1px 3px; border-radius: 2px; }
  .logo-text h1 { font-family: 'Playfair Display', serif; font-size: 14px; font-weight: 800; color: white; line-height: 1.1; }
  .logo-text p { font-size: 10px; color: rgba(255,255,255,0.6); margin-top: 2px; }
  .header-nav { display: flex; gap: 3px; }
  .nav-btn { background: transparent; border: none; color: rgba(255,255,255,0.7); font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 500; padding: 7px 11px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; gap: 5px; transition: all 0.2s; white-space: nowrap; }
  .nav-btn i { font-size: 15px; }
  .nav-btn:hover { background: rgba(255,255,255,0.1); color: white; }
  .nav-btn.active { background: var(--gold); color: white; }

  .page { display: none; }
  .page.active { display: block; }

  /* HOME */
  .hero { position: relative; height: 460px; overflow: hidden; }
  .hero-img { width: 100%; height: 100%; object-fit: cover; object-position: center top; filter: brightness(0.62) saturate(0.9); }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(15,61,43,0.25) 0%, rgba(15,61,43,0.65) 55%, rgba(15,61,43,0.96) 100%); display: flex; flex-direction: column; align-items: center; justify-content: flex-end; padding: 40px 24px; text-align: center; }
  .hero-badge { background: var(--gold); color: white; font-size: 11px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; padding: 5px 16px; border-radius: 20px; margin-bottom: 14px; display: inline-block; }
  .hero h2 { font-family: 'Playfair Display', serif; font-size: 40px; font-weight: 800; color: white; line-height: 1.15; margin-bottom: 10px; }
  .hero-sub { font-size: 14px; color: rgba(255,255,255,0.8); }
  .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); background: var(--green-dark); border-bottom: 1px solid rgba(255,255,255,0.08); }
  .stat-item { padding: 22px 16px; text-align: center; border-right: 1px solid rgba(255,255,255,0.08); }
  .stat-item:last-child { border-right: none; }
  .stat-num { font-family: 'Playfair Display', serif; font-size: 32px; font-weight: 700; color: var(--gold-light); }
  .stat-lbl { font-size: 11px; color: rgba(255,255,255,0.55); margin-top: 3px; letter-spacing: 0.5px; }
  .section { max-width: 1100px; margin: 0 auto; padding: 40px 24px; }
  .section-title { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: var(--green-dark); margin-bottom: 6px; }
  .section-sub { font-size: 13px; color: var(--text-muted); margin-bottom: 22px; }
  .divider { width: 40px; height: 3px; background: var(--gold); border-radius: 2px; margin-bottom: 14px; }
  .amenities-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .amenity { background: white; border: 1px solid var(--border); border-radius: 14px; padding: 20px 14px; text-align: center; transition: box-shadow 0.2s, transform 0.2s; }
  .amenity:hover { box-shadow: 0 4px 16px rgba(15,61,43,0.12); transform: translateY(-2px); }
  .amenity-icon { width: 46px; height: 46px; border-radius: 12px; background: #e8f5ee; color: var(--green-mid); display: flex; align-items: center; justify-content: center; font-size: 22px; margin: 0 auto 10px; }
  .amenity-name { font-size: 12px; font-weight: 600; color: var(--text); line-height: 1.3; }
  .amenity-desc { font-size: 10.5px; color: var(--text-muted); margin-top: 3px; }
  .notice { background: linear-gradient(135deg, var(--green-dark), var(--green-mid)); border-radius: 14px; padding: 20px 24px; display: flex; align-items: center; gap: 16px; margin-top: 28px; }
  .notice i { font-size: 28px; color: var(--gold-light); flex-shrink: 0; }
  .notice-text h4 { font-size: 14px; font-weight: 600; color: white; margin-bottom: 3px; }
  .notice-text p { font-size: 12px; color: rgba(255,255,255,0.7); }

  /* PAGE HERO */
  .page-hero { background: linear-gradient(135deg, var(--green-dark) 0%, var(--green-mid) 100%); padding: 40px 24px 30px; text-align: center; position: relative; overflow: hidden; }
  .page-hero::before { content: ''; position: absolute; top: -60px; right: -60px; width: 200px; height: 200px; border-radius: 50%; background: rgba(255,255,255,0.04); }
  .page-hero h2 { font-family: 'Playfair Display', serif; font-size: 28px; color: white; font-weight: 800; }
  .page-hero p { font-size: 13px; color: rgba(255,255,255,0.65); margin-top: 6px; }

  /* MEMBERS */
  .members-content { max-width: 1100px; margin: 0 auto; padding: 32px 24px; }
  .members-grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 10px; margin-bottom: 12px; }
  .member-card { background: white; border: 1px solid var(--border); border-radius: 12px; padding: 14px 8px; text-align: center; text-decoration: none; display: block; transition: all 0.2s; }
  .member-card:hover { border-color: var(--green-accent); box-shadow: 0 4px 14px rgba(15,61,43,0.12); transform: translateY(-2px); }
  .avatar-circle { width: 44px; height: 44px; border-radius: 50%; margin: 0 auto 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 13px; color: white; font-family: 'Playfair Display', serif; }
  .flat-no { font-size: 11px; font-weight: 600; color: var(--text); }
  .flat-type { font-size: 10px; color: var(--text-muted); margin-top: 2px; }
  .block-label { font-size: 11px; font-weight: 700; color: var(--green-dark); letter-spacing: 0.5px; margin: 18px 0 8px; text-transform: uppercase; }
  .view-all { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 14px; border: 1.5px solid var(--green-mid); border-radius: 10px; color: var(--green-mid); font-size: 13px; font-weight: 600; text-decoration: none; transition: all 0.2s; background: white; margin-top: 16px; }
  .view-all:hover { background: var(--green-dark); color: white; border-color: var(--green-dark); }

  /* SERVICES */
  .services-content { max-width: 1100px; margin: 0 auto; padding: 32px 24px; }
  .services-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .service-card { background: white; border: 1px solid var(--border); border-radius: 16px; padding: 28px; text-decoration: none; display: flex; gap: 20px; align-items: flex-start; transition: all 0.2s; }
  .service-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); border-color: transparent; }
  .svc-icon { width: 58px; height: 58px; border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 26px; flex-shrink: 0; }
  .svc-water { background: #dbeeff; color: #1565c0; }
  .svc-maint { background: #fff3e0; color: #bf5e00; }
  .svc-park  { background: #f3e5f5; color: #6a1b9a; }
  .svc-member { background: #e8f5ee; color: var(--green-dark); }
  .svc-body h3 { font-size: 16px; font-weight: 700; color: var(--text); margin-bottom: 5px; }
  .svc-body p { font-size: 12.5px; color: var(--text-muted); line-height: 1.5; margin-bottom: 12px; }
  .svc-link { font-size: 12.5px; font-weight: 600; color: var(--green-mid); display: flex; align-items: center; gap: 5px; }

  /* ── ASSOCIATION PAGE ── */
  .assoc-content { max-width: 1100px; margin: 0 auto; padding: 36px 24px; }

  /* Committee */
  .committee-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 40px; }
  .committee-card {
    background: white; border: 1px solid var(--border); border-radius: 16px;
    padding: 24px 20px; text-align: center; position: relative; overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .committee-card:hover { box-shadow: 0 6px 20px rgba(15,61,43,0.1); transform: translateY(-2px); }
  .committee-card.president { border-top: 4px solid var(--gold); }
  .committee-card.secretary { border-top: 4px solid var(--green-mid); }
  .committee-card.treasurer { border-top: 4px solid #c0392b; }
  .committee-card.member-role { border-top: 4px solid #7f8c8d; }
  .cmember-avatar {
    width: 64px; height: 64px; border-radius: 50%; margin: 0 auto 12px;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: white;
  }
  .cmember-role { font-size: 10.5px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px; }
  .cmember-name { font-size: 15px; font-weight: 700; color: var(--text); margin-bottom: 3px; }
  .cmember-flat { font-size: 11.5px; color: var(--text-muted); }
  .cmember-phone { font-size: 11.5px; color: var(--green-mid); margin-top: 8px; display: flex; align-items: center; justify-content: center; gap: 5px; }

  /* Meetings */
  .meetings-list { display: flex; flex-direction: column; gap: 12px; margin-bottom: 40px; }
  .meeting-item {
    background: white; border: 1px solid var(--border); border-radius: 12px;
    padding: 16px 20px; display: flex; align-items: flex-start; gap: 16px;
  }
  .meeting-date {
    background: var(--green-dark); color: white; border-radius: 10px;
    padding: 8px 12px; text-align: center; flex-shrink: 0; min-width: 56px;
  }
  .meeting-date .day { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; line-height: 1; }
  .meeting-date .mon { font-size: 10px; letter-spacing: 1px; text-transform: uppercase; opacity: 0.8; margin-top: 2px; }
  .meeting-body h4 { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 4px; }
  .meeting-body p { font-size: 12px; color: var(--text-muted); line-height: 1.5; }
  .meeting-tag {
    display: inline-block; font-size: 10px; font-weight: 600; padding: 2px 10px;
    border-radius: 20px; margin-top: 6px; letter-spacing: 0.3px;
  }
  .tag-upcoming { background: #e8f5ee; color: var(--green-dark); }
  .tag-completed { background: #f0f0f0; color: #666; }

  /* Rules */
  .rules-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 40px; }
  .rule-card { background: white; border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px; }
  .rule-header { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .rule-icon { width: 36px; height: 36px; border-radius: 9px; background: #e8f5ee; color: var(--green-mid); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
  .rule-header h4 { font-size: 13px; font-weight: 700; color: var(--text); }
  .rule-list { list-style: none; }
  .rule-list li { font-size: 12px; color: var(--text-muted); padding: 4px 0; border-bottom: 1px solid #f5f0e8; display: flex; align-items: flex-start; gap: 7px; line-height: 1.45; }
  .rule-list li:last-child { border-bottom: none; }
  .rule-list li::before { content: '›'; color: var(--gold); font-weight: 700; font-size: 14px; flex-shrink: 0; margin-top: -1px; }

  /* Contact / Complaint */
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .contact-info { background: linear-gradient(135deg, var(--green-dark), var(--green-mid)); border-radius: 16px; padding: 28px; }
  .contact-info h3 { font-family: 'Playfair Display', serif; font-size: 18px; color: white; font-weight: 700; margin-bottom: 20px; }
  .contact-row { display: flex; align-items: flex-start; gap: 12px; margin-bottom: 16px; }
  .contact-row i { font-size: 20px; color: var(--gold-light); flex-shrink: 0; margin-top: 1px; }
  .contact-row .cl { font-size: 10.5px; color: rgba(255,255,255,0.55); margin-bottom: 2px; }
  .contact-row .cv { font-size: 13px; color: white; font-weight: 500; }

  .complaint-form { background: white; border: 1px solid var(--border); border-radius: 16px; padding: 28px; }
  .complaint-form h3 { font-family: 'Playfair Display', serif; font-size: 18px; color: var(--green-dark); font-weight: 700; margin-bottom: 20px; }
  .form-group { margin-bottom: 14px; }
  .form-group label { display: block; font-size: 11.5px; font-weight: 600; color: var(--text-muted); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 0.5px; }
  .form-group input, .form-group select, .form-group textarea {
    width: 100%; padding: 10px 13px; border: 1px solid var(--border);
    border-radius: 8px; font-family: 'Inter', sans-serif; font-size: 13px;
    color: var(--text); background: var(--cream); outline: none;
    transition: border-color 0.2s;
  }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: var(--green-accent); background: white; }
  .form-group textarea { resize: vertical; min-height: 90px; }
  .submit-btn {
    width: 100%; padding: 12px; background: var(--green-dark); color: white;
    border: none; border-radius: 9px; font-family: 'Inter', sans-serif;
    font-size: 14px; font-weight: 600; cursor: pointer; transition: background 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 8px;
  }
  .submit-btn:hover { background: var(--green-mid); }
  .form-success { display: none; background: #e8f5ee; border: 1px solid #a5d6a7; border-radius: 8px; padding: 14px 16px; text-align: center; color: var(--green-dark); font-size: 13px; font-weight: 500; margin-top: 10px; }

  footer { background: var(--green-dark); color: rgba(255,255,255,0.5); text-align: center; padding: 20px; font-size: 11.5px; border-top: 1px solid rgba(255,255,255,0.08); }
  footer strong { color: rgba(255,255,255,0.8); }
</style>
</head>
